#!/usr/bin/env bash

export PROTON_XESS_UPGRADE=${PROTON_XESS_UPGRADE:-1}
export LOW_LATENCY_LAYER=${LOW_LATENCY_LAYER:-1}
# Changes the Optiscaler menu button to "Home" instead of the default "Insert"
export PROTON_OPTISCALER_CONFIG="Menu.ShortcutKey=0x24"

if command -v nvidia-smi &>/dev/null; then
  export PROTON_DLSS_UPGRADE=${PROTON_DLSS_UPGRADE:-1}
  export PROTON_NVIDIA_LIBS=${PROTON_NVIDIA_LIBS:-1}
else
  # Could do a conditional check with "pacman -Qs amd-ucode &>/dev/null"?
  export PROTON_FSR4_RDNA3_UPGRADE=${PROTON_FSR4_RDNA3_UPGRADE:-1}
fi

if command -v scxctl >/dev/null && [[ "$DISABLE_SCX" != "1" ]]; then
  if [[ "$(scxctl get)" == "no scx scheduler running" ]]; then
    scxctl start -s "${SCX_SCHED:-lavd}" -m gaming
  fi
fi

game-performance mangohud "$@"

if command -v scxctl >/dev/null && [[ "$DISABLE_SCX" != "1" ]]; then
  # Check if another game is running at the same time
  # We only want to stop scx-sched if we are done gaming
  if ! (ps aux | grep -q "[g]ame-performance"); then
    scxctl stop
  fi
fi
