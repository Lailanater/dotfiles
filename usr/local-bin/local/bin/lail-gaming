#!/usr/bin/env bash

## Optiscaler ##
# Changes the Optiscaler menu button to "Home" instead of the default "Insert"
export PROTON_OPTISCALER_CONFIG="Menu.ShortcutKey=0x24"

## FSR ##
export PROTON_FSR4_UPGRADE=${PROTON_FSR4_UPGRADE:-1}

## Low Latency ##
export LOW_LATENCY_LAYER=${LOW_LATENCY_LAYER:-1}

## Mangohud ##
export MANGOHUD=${MANGOHUD:-1}
if [[ -n "$FPS_LIMIT" ]]; then
  # FPS_LIMIT=0 is uncapped
  export MANGOHUD_CONFIG=read_cfg,fps_limit=${FPS_LIMIT}
fi

exec game-performance "$@"
